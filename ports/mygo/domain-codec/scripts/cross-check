#!/usr/bin/env bash
# Compile-only checks, not platform runtime or desktop acceptance.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
GO="${GO:-go}"
BUILD_ROOT="${NOONMARK_CODEC_BUILD_ROOT:-${TMPDIR:-/tmp}/noonmark-codec-build}"
case "$BUILD_ROOT" in /*) ;; *) echo 'Use an absolute external build root' >&2; exit 1;; esac
case "$BUILD_ROOT/" in "$ROOT/"*) echo 'Build root must be outside source' >&2; exit 1;; esac
mkdir -p "$BUILD_ROOT/cache" "$BUILD_ROOT/modcache" "$BUILD_ROOT/cross"
export GOCACHE="$BUILD_ROOT/cache" GOMODCACHE="$BUILD_ROOT/modcache"
export GOTOOLCHAIN=local GOTELEMETRY=off GOMAXPROCS="${GOMAXPROCS:-2}"
cd "$ROOT"
for platform in linux/amd64 linux/arm64 windows/amd64 windows/arm64 darwin/amd64 darwin/arm64; do
 os="${platform%/*}"; arch="${platform#*/}"
 for package in canonical v7; do
  suffix=test; [[ "$os" == windows ]] && suffix=exe
  CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" "$GO" test -c -o "$BUILD_ROOT/cross/${package}-${os}-${arch}.$suffix" "./$package"
  printf 'COMPILE PASS %s %s\n' "$platform" "$package"
 done
done
