#!/usr/bin/env bash
set -euo pipefail
source "$(dirname -- "$0")/environment"
for target in linux/amd64 linux/arm64 windows/amd64 windows/arm64 darwin/amd64 darwin/arm64; do
  os=${target%/*}; arch=${target#*/}; suffix=; test "$os" != windows || suffix=.exe
  CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" "$GO" build -p=1 -buildvcs=false -o "$BUILD_ROOT/bin/noonmark-mygo-$os-$arch$suffix" .
  printf 'COMPILED %s (not runtime verified)\n' "$target"
done
