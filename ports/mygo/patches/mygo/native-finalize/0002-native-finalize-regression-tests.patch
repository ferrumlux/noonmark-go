+func TestNoonmarkFinishQueueAndUndo(t *testing.T) {
+	draft := "old"
+	var h Handle
+	var c *Context
+	tt := NewTester(func(ctx *Context) { c = ctx; TextAreaBase(c, &draft).Bind(&h).AutoFocus().Width(250) }, 300, 180)
+	defer tt.rt.close()
+	client := tt.h.ime.Client
+	// Native selection replacement is one composition undo transaction.
+	client.SetMarkedText(&TextInputRange{Start: 0, End: 3}, "未定", TextInputRange{Start: 2, End: 2})
+	got, ok := h.FinishTextEditing(c)
+	if !ok || got.Text != "未定" {
+		t.Fatal(got, ok)
+	}
+	h.Focus(c)
+	tt.Frame()
+	tt.rt.editEvent(editEvent{kind: editCommand, text: "undo"})
+	if len(tt.rt.states[tt.rt.focused].editor.queue) == 0 {
+		t.Fatal("undo was not queued")
+	}
+	got, ok = h.FinishTextEditing(c)
+	if !ok || got.Text != "old" {
+		t.Fatal("queued undo", got, ok)
+	}
+	h.Focus(c)
+	tt.Frame()
+	tt.rt.keyDown(0, KeyLeft, false)
+	if len(tt.rt.states[tt.rt.focused].editor.queue) == 0 {
+		t.Fatal("navigation was not queued")
+	}
+	tt.h.ime.Client.ReplaceText(nil, "!")
+	got, ok = h.FinishTextEditing(c)
+	if !ok || got.Text != "ol!d" {
+		t.Fatal("queued navigation before native replacement", got, ok)
+	}
+}
