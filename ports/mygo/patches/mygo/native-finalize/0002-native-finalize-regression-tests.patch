+func TestNoonmarkFinishReentrantCloseAndLateSave(t *testing.T) {
+	draft := "old"
+	var h Handle
+	var c *Context
+	tt := NewTester(func(ctx *Context) { c = ctx; TextAreaBase(c, &draft).Bind(&h).AutoFocus().Width(200) }, 300, 180)
+	tt.h.clipboard = "paste"
+	tt.h.reading = func() {
+		if _, ok := h.FinishTextEditing(c); ok {
+			t.Fatal("reentrant finish succeeded")
+		}
+		tt.rt.close()
+	}
+	tt.rt.editEvent(editEvent{kind: editCommand, text: "paste"})
+	if len(tt.rt.states[tt.rt.focused].editor.queue) == 0 {
+		t.Fatal("paste was not queued")
+	}
+	if _, ok := h.FinishTextEditing(c); ok {
+		t.Fatal("closed during queued callback still succeeded")
+	}
+	if _, ok := h.TextInputSnapshot(c); ok {
+		t.Fatal("late async completion can resolve closed editor")
+	}
+	// An application completion must carry its own owner/generation. No API
+	// revision pretends that a new binding is the owner of an older save.
+	var r Handle
+	var current *Context
+	value := "session-one"
+	owner := uint64(1)
+	second := NewTester(func(ctx *Context) {
+		current = ctx
+		TextAreaBase(current.Key(owner), &value).Bind(&r).AutoFocus().Width(200)
+	}, 300, 180)
+	defer second.rt.close()
+	saveOwner := owner
+	saved, ok := r.FinishTextEditing(current)
+	if !ok {
+		t.Fatal("save snapshot")
+	}
+	owner++
+	value = "session-two"
+	second.Frame()
+	applyCompletion := func() {
+		if owner != saveOwner {
+			return
+		}
+		if _, valid := r.TextInputSnapshot(current); valid {
+			value = saved.Text
+		}
+	}
+	applyCompletion()
+	if value != "session-two" {
+		t.Fatal("late save crossed owner")
+	}
+	second.rt.close()
+	applyCompletion()
+}
