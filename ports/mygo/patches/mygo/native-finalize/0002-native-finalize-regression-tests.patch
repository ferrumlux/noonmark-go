+func TestNoonmarkFinishBeforeFrame(t *testing.T) {
+	for _, kind := range []string{"replace", "marked", "selection", "empty-commit", "cancel-preedit", "empty-preedit", "multiline"} {
+		t.Run(kind, func(t *testing.T) {
+			draft := "old"
+			var h Handle
+			var c *Context
+			builds := 0
+			tt := NewTester(func(ctx *Context) {
+				c = ctx
+				builds++
+				TextAreaBase(c.Key("title"), &draft).Bind(&h).AutoFocus().Width(250)
+			}, 300, 180)
+			defer tt.rt.close()
+			old := tt.h.ime.Client
+			want := "old未定"
+			committed := "old"
+			marked := "未定"
+			switch kind {
+			case "replace":
+				old.ReplaceText(nil, "新")
+				want = "old新"
+				committed = want
+				marked = ""
+			case "marked":
+				old.SetMarkedText(nil, "未定", TextInputRange{Start: 2, End: 2})
+			case "selection":
+				old.SetMarkedText(&TextInputRange{Start: 0, End: 3}, "未定", TextInputRange{Start: 2, End: 2})
+				want = "未定"
+				committed = ""
+			case "empty-commit":
+				old.ReplaceText(&TextInputRange{Start: 0, End: 3}, "")
+				want = ""
+				committed = ""
+				marked = ""
+			case "cancel-preedit":
+				old.SetMarkedText(nil, "未定", TextInputRange{})
+				old.SetMarkedText(nil, "", TextInputRange{})
+				want = "old"
+				marked = ""
+			case "empty-preedit":
+				old.SetMarkedText(nil, "", TextInputRange{})
+				want = "old"
+				marked = ""
+			case "multiline":
+				old.ReplaceText(nil, "\n新")
+				want = "old\n新"
+				committed = want
+				marked = ""
+			}
+			beforeBuild, frame := builds, tt.rt.frame
+			tt.h.hidden = true
+			got, ok := h.TextInputSnapshot(c)
+			if !ok || got.Text != committed || got.MarkedText != marked || got.Composing != (marked != "") {
+				t.Fatalf("snapshot=%+v ok=%v", got, ok)
+			}
+			if draft != "old" {
+				t.Fatalf("snapshot published %q", draft)
+			}
+			got, ok = h.FinishTextEditing(c)
+			if !ok || got.Text != want || got.Composing || draft != want {
+				t.Fatalf("finish=%+v ok=%v binding=%q want=%q", got, ok, draft, want)
+			}
+			if builds != beforeBuild || tt.rt.frame != frame || tt.h.ime.Active {
+				t.Fatal("finish depended on a frame or left route active")
+			}
+			old.ReplaceText(nil, "late")
+			old.SetMarkedText(nil, "late", TextInputRange{})
+			old.UnmarkText()
+			again, ok := h.FinishTextEditing(c)
+			if !ok || again != got || draft != want {
+				t.Fatal("repeat/late changed result", again, draft)
+			}
+			tt.h.hidden = false
+			h.Focus(c)
+			tt.Frame()
+			fresh := tt.h.ime.Client
+			if fresh == nil || fresh == old {
+				t.Fatal("refocus reused stale lease")
+			}
+			old.ReplaceText(nil, "stale-after-refocus")
+			fresh.ReplaceText(nil, "!")
+			got, ok = h.FinishTextEditing(c)
+			if !ok || got.Text != want+"!" {
+				t.Fatal("refocus route failed", got)
+			}
+		})
+	}
+}
