+func TestNoonmarkFinishHostReentry(t *testing.T) {
+	for _, closeDuring := range []bool{false, true} {
+		draft := "old"
+		var handle Handle
+		var c *Context
+		tt := NewTester(func(ctx *Context) { c = ctx; TextAreaBase(c, &draft).Bind(&handle).AutoFocus().Width(200) }, 300, 180)
+		client := tt.h.ime.Client
+		client.SetMarkedText(&TextInputRange{Start: 0, End: 3}, "未定", TextInputRange{})
+		resets := 0
+		tt.rt.host = &noonmarkFinishHost{headless: tt.h, onSet: func(s platform.TextInputState) {
+			if s.Active {
+				return
+			}
+			resets++
+			if draft != "未定" {
+				t.Fatal("host deactivated before committed string published", draft)
+			}
+			client.ReplaceText(nil, "late-host")
+			client.UnmarkText()
+			if _, ok := handle.FinishTextEditing(c); ok {
+				t.Fatal("host reentrant finish succeeded")
+			}
+			if closeDuring {
+				tt.rt.close()
+			}
+		}}
+		got, ok := handle.FinishTextEditing(c)
+		if ok == closeDuring || draft != "未定" || resets != 1 {
+			t.Fatal("host result", got, ok, draft, resets, closeDuring)
+		}
+		tt.rt.close()
+	}
+}
