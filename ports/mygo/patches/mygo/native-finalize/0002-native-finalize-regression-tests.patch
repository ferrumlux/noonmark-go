+func TestNoonmarkFinishLocalBindingAndReentry(t *testing.T) {
+	value := "old"
+	var h Handle
+	var c *Context
+	var last *string
+	tt := NewTester(func(ctx *Context) {
+		c = ctx
+		local := value
+		TextAreaBase(c.Key("title"), &local).Bind(&h).AutoFocus().Width(200)
+		last = &local
+		value = local
+	}, 300, 180)
+	defer tt.rt.close()
+	old := tt.h.ime.Client
+	old.SetMarkedText(nil, "未定", TextInputRange{})
+	tt.Frame()
+	if tt.h.ime.Client != old {
+		t.Fatal("per-build local binding reset native session")
+	}
+	snap, ok := h.FinishTextEditing(c)
+	if !ok || snap.Text != "old未定" || *last != "old未定" || value != "old" {
+		t.Fatal("local binding contract", snap, *last, value)
+	}
+	// A frame-local copy cannot magically publish into an application field that
+	// was copied from it earlier. Caller must consume returned Text explicitly.
+	value = snap.Text
+	h.Focus(c)
+	tt.Frame()
+	fresh := tt.h.ime.Client
+	tt.h.clipboard = "!"
+	tt.h.reading = func() {
+		fresh.ReplaceText(nil, "BAD")
+		tt.rt.editEvent(editEvent{kind: editInsert, text: "BAD"})
+		tt.rt.keyDown(0, KeyBackspace, false)
+		if _, ok := h.FinishTextEditing(c); ok {
+			t.Fatal("nested finish accepted")
+		}
+	}
+	tt.rt.editEvent(editEvent{kind: editCommand, text: "paste"})
+	got, ok := h.FinishTextEditing(c)
+	if !ok || got.Text != "old未定!" {
+		t.Fatal("native route reentered finish", got, ok)
+	}
+}
