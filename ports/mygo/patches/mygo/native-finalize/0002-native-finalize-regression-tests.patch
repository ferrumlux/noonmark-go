+func TestNoonmarkFinishMultiWindowAndRebind(t *testing.T) {
+	var h Handle
+	var a, b *Context
+	first, second := "A", "B"
+	left := NewTester(func(c *Context) { a = c; TextAreaBase(c, &first).Bind(&h).AutoFocus().Width(200) }, 300, 180)
+	defer left.rt.close()
+	right := NewTester(func(c *Context) { b = c; TextAreaBase(c, &second).Bind(&h).AutoFocus().Width(200) }, 300, 180)
+	defer right.rt.close()
+	left.h.ime.Client.ReplaceText(nil, "1")
+	right.h.ime.Client.ReplaceText(nil, "2")
+	if got, ok := h.FinishTextEditing(a); !ok || got.Text != "A1" || second != "B" || !right.h.ime.Active {
+		t.Fatal("cross-window finish", got, second)
+	}
+	if got, ok := h.FinishTextEditing(b); !ok || got.Text != "B2" {
+		t.Fatal("second window finish", got)
+	}
+	left.rt.close()
+	if _, ok := h.FinishTextEditing(a); ok {
+		t.Fatal("closed window lease")
+	}
+	if _, ok := h.TextInputSnapshot(b); !ok {
+		t.Fatal("other window invalidated")
+	}
+
+	var r Handle
+	var c *Context
+	x, y := "old", "NEW"
+	target := &x
+	session := 1
+	tt := NewTester(func(ctx *Context) { c = ctx; TextAreaBase(c.Key(session), target).Bind(&r).AutoFocus().Width(200) }, 300, 180)
+	defer tt.rt.close()
+	old := tt.h.ime.Client
+	target = &y
+	session++
+	tt.Frame()
+	fresh := tt.h.ime.Client
+	old.ReplaceText(nil, "bad")
+	fresh.ReplaceText(nil, "!")
+	got, ok := r.FinishTextEditing(c)
+	if !ok || got.Text != "NEW!" || x != "old" || fresh == old {
+		t.Fatal("rebound native lease", got, x, y)
+	}
+}
