+func TestNoonmarkFinishIdentityAndPolicy(t *testing.T) {
+	for _, kind := range []string{"unbound", "omitted", "hidden", "ancestor-hidden", "reused-id", "closed", "readonly", "disabled", "buffer", "custom", "build"} {
+		t.Run(kind, func(t *testing.T) {
+			draft := "old"
+			var h Handle
+			var c *Context
+			phase := false
+			tt := NewTester(func(ctx *Context) {
+				c = ctx
+				if phase && kind == "omitted" {
+					return
+				}
+				build := func() {
+					var e Element
+					switch kind {
+					case "buffer":
+						e = TextAreaBufferBase(c.Key("title"), NewTextBuffer("old"))
+					case "custom":
+						e = Box(c.Key("title")).HandleTextInput(&primitiveClient{text: "old"})
+					default:
+						e = TextAreaBase(c.Key("title"), &draft)
+					}
+					if !(phase && (kind == "unbound" || kind == "reused-id")) {
+						e = e.Bind(&h)
+					}
+					e.AutoFocus().Width(200)
+					if kind == "hidden" && phase {
+						e.Hidden(true)
+					}
+					if kind == "readonly" && phase {
+						e.ReadOnly(true)
+					}
+					if kind == "disabled" && phase {
+						e.Disabled(true)
+					}
+					if kind == "build" {
+						if _, ok := h.FinishTextEditing(c); ok {
+							t.Fatal("accepted in build")
+						}
+					}
+				}
+				if kind == "ancestor-hidden" {
+					Column(c).Hidden(phase).Children(build)
+				} else {
+					build()
+				}
+			}, 300, 180)
+			defer tt.rt.close()
+			old := tt.h.ime.Client
+			phase = true
+			if kind == "reused-id" {
+				// Destroy state while keeping the same public identity key; replacement
+				// deliberately does not bind h. Its pool storage can reuse the old state.
+				saved := tt.rt.view
+				tt.rt.view = func(*context) {}
+				tt.Frame()
+				tt.rt.view = saved
+			}
+			tt.Frame()
+			if kind == "closed" {
+				tt.rt.close()
+			}
+			if kind == "build" {
+				return
+			}
+			if _, ok := h.FinishTextEditing(c); ok {
+				t.Fatal("invalid or unsupported finish succeeded")
+			}
+			if kind == "readonly" || kind == "disabled" {
+				if snap, ok := h.TextInputSnapshot(c); !ok || snap.Text != "old" {
+					t.Fatal("cannot read policy-protected value", snap, ok)
+				}
+			} else if _, ok := h.TextInputSnapshot(c); ok {
+				t.Fatal("invalid snapshot succeeded")
+			}
+			if old != nil {
+				old.ReplaceText(nil, "late")
+			}
+			if kind == "readonly" || kind == "disabled" || kind == "closed" || kind == "hidden" || kind == "ancestor-hidden" || kind == "reused-id" {
+				if draft != "old" {
+					t.Fatal("stale client changed binding")
+				}
+			}
+		})
+	}
+	var zero Handle
+	if _, ok := zero.FinishTextEditing(nil); ok {
+		t.Fatal("nil context accepted")
+	}
+	if _, ok := zero.TextInputSnapshot(&Context{}); ok {
+		t.Fatal("empty context accepted")
+	}
+}
