+//go:build !js
+
+package mygo
+
+import (
+	"slices"
+	"testing"
+
+	"github.com/egoist/mygo/internal/platform"
+	"github.com/egoist/mygo/ui"
+)
+
+func TestNoonmarkContentPopupCompletion(t *testing.T) {
+	for _, closed := range []bool{false, true} {
+		t.Run(map[bool]string{false: "dismissed", true: "closed-before-show"}[closed], func(t *testing.T) {
+			w, _, _ := contentWindow(t, func(c *ui.Context) { ui.Text(c, "Synthetic menu owner") })
+			var got []int
+			onMain(func() {
+				w.conn.PopupMenu(&platform.Menu{Items: []*platform.MenuItem{{ID: 1, Label: "Act", Enabled: true, Visible: true}}}, 0, 0, func(id int) { got = append(got, id) })
+				if closed {
+					w.Destroy()
+				}
+			})
+			onMain(func() {}) // The posted popup ran; the fake backend dismisses immediately.
+			if !slices.Equal(got, []int{0}) {
+				t.Fatalf("popup completion = %v, want [0]", got)
+			}
+		})
+	}
+}
