+package ui
+
+// TextInputSnapshot separates the built-in editor's committed text from its
+// virtual preedit. Text excludes MarkedText. Composing means nonempty preedit;
+// an empty preedit ends composition, following Element.Composing. This is not
+// a persistence revision or an application owner/generation token.
+type TextInputSnapshot struct {
+	Text       string
+	MarkedText string
+	Composing  bool
+}
+
+// textInput resolves only committed, presently built string-control identity.
+// It never reads a retained Element between frames. Recycled state/ID or a
+// missing Bind cannot restore the identity of a previously bound editor.
+func (h Handle) textInput(c *Context) (*refState, *state, *widgetTextInput) {
+	rt := c.runtime()
+	if rt == nil || rt.inFrame || rt.textInputClosed {
+		return nil, nil, nil
+	}
+	b := (&h).binding(rt, false)
+	if b == nil || b.closed || b.id == 0 || b.textClient == nil {
+		return nil, nil, nil
+	}
+	s, w := rt.states[b.id], b.textClient
+	if s == nil || s.seen != rt.frame || s.pass != rt.pass || s.editor != w.ed ||
+		s.textClient != w || w.rt != rt || w.id != b.id || w.ed.document != nil ||
+		w.ed.value == nil || w.ed.value != b.textValue || w.processing {
+		return nil, nil, nil
+	}
+	return b, s, w
+}
+
+// syncString follows applyString's conflict rule: an application value changed
+// since the native edit wins. It does not publish native input to the binding.
+func (w *widgetTextInput) syncString() {
+	ed := w.ed
+	before := ed.buf.s
+	if ed.nativeDirty {
+		before = ed.nativeValue
+	}
+	if *ed.value != before {
+		ed.setText(*ed.value)
+		ed.compose, ed.composeCaret, ed.composeSelected = "", 0, TextInputRange{}
+		ed.nativeDirty, ed.nativeValue = false, ""
+	}
+}
+
+func (w *widgetTextInput) snapshot() TextInputSnapshot {
+	return TextInputSnapshot{Text: w.ed.buf.s, MarkedText: w.ed.compose, Composing: w.ed.compose != ""}
+}
+
+// TextInputSnapshot reads a built-in string TextInput/TextArea on the UI thread
+// BETWEEN build frames. It reconciles external value changes and drains input
+// already queued for this editor; it does not unmark or publish the string.
+// No frame or painting is required, including in an occluded window.
+//
+// False means closed, hidden, missing/reused identity, a build in progress,
+// reentrant input processing, or an unsupported binding (TextBuffer/custom
+// TextInputClient). Read-only/disabled controls may be read but are not drained.
+func (h Handle) TextInputSnapshot(c *Context) (TextInputSnapshot, bool) {
+	return h.textSnapshot(c, false)
+}
+
+func (h Handle) textSnapshot(c *Context, finishing bool) (TextInputSnapshot, bool) {
+	b, s, w := h.textInput(c)
+	if w == nil || w.finishing != finishing {
+		return TextInputSnapshot{}, false
+	}
+	value := b.textValue
+	w.syncString()
+	before := *value
+	if s.flags&flagDisabled == 0 && !w.ed.readOnly {
+		w.prepare()
+	}
+	// OnTextKey/clipboard processing can reenter the application or close it.
+	b2, _, w2 := h.textInput(c)
+	if w2 != w || b2.textValue != value {
+		return TextInputSnapshot{}, false
+	}
+	if *value != before {
+		w.ed.nativeDirty, w.ed.nativeValue = true, before
+		w.syncString()
+	}
+	return w.snapshot(), true
+}
+
+// FinishTextEditing drains already-delivered input, commits current preedit,
+// synchronously publishes the string binding, and permanently revokes the old
+// native-client lease. It clears this control's focus and pending focus request.
+// Repeated calls are harmless. A later explicit focus uses a fresh lease.
+//
+// Call on the UI thread BETWEEN build frames, before hiding/removing/closing
+// the editor. False has the same validity/unsupported meanings as Snapshot and
+// also rejects read-only/disabled controls. No render, sleep, or future frame is
+// involved. An external application value wins a native-value conflict.
+//
+// This boundary commits input already delivered to ui and invokes the host
+// via its existing inactive SetTextInput reset/discard path. It is not an
+// acknowledgement of future OS events or a guarantee against process death.
+// Keep application owner/generation and asynchronous-save guards separately.
+func (h Handle) FinishTextEditing(c *Context) (TextInputSnapshot, bool) {
+	b, s, w := h.textInput(c)
+	if w == nil || w.finishing || s.flags&flagDisabled != 0 || w.ed.readOnly {
+		return TextInputSnapshot{}, false
+	}
+	value, rt := b.textValue, w.rt
+	w.finishing = true
+	defer func() { w.finishing = false }()
+	// Invalidate the previous capability before any callback or host reentry.
+	// This does not itself unmark: the explicit sequence below owns that once.
+	if s.textAdapter != nil {
+		s.textAdapter.revoked = true
+	}
+	snapshot, ok := h.textSnapshot(c, true)
+	if !ok {
+		return TextInputSnapshot{}, false
+	}
+	b2, s2, w2 := h.textInput(c)
+	if w2 != w || s2 != s || b2.textValue != value || s.flags&flagDisabled != 0 || w.ed.readOnly {
+		return TextInputSnapshot{}, false
+	}
+	w.UnmarkText()
+	// Unlike native UnmarkText, this is a terminal edit boundary, not the
+	// preedit-end half of a platform's later replacement transaction.
+	w.ed.compositionActive = false
+	if *value != w.ed.buf.s {
+		*value = w.ed.buf.s
+		s.markChanged()
+	}
+	w.ed.nativeDirty, w.ed.nativeValue = false, ""
+	snapshot = w.snapshot()
+	b.requested = false
+	if rt.focused == s.id {
+		rt.focused = 0
+	}
+	rt.updateTextInput()
+	// Host reset/discard may synchronously call application code. Do not return
+	// a live-identity success after that code closed or replaced this editor.
+	b2, s2, w2 = h.textInput(c)
+	if w2 != w || s2 != s || b2.textValue != value || s.flags&flagDisabled != 0 || w.ed.readOnly {
+		return TextInputSnapshot{}, false
+	}
+	// Same identity is not evidence that a host callback left its binding
+	// untouched. Apply the existing external-value-wins rule once more and
+	// return the actual terminal text, not the snapshot taken before the host.
+	w.syncString()
+	snapshot = w.snapshot()
+	rt.requestFrame()
+	return snapshot, true
+}
