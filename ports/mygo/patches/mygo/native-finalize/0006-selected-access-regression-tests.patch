+//go:build windows && (amd64 || arm64)
+
+package windows
+
+import (
+	"github.com/egoist/mygo/internal/platform"
+	"testing"
+)
+
+func TestNoonmarkSelectionPatternTransitions(t *testing.T) {
+	plain := platform.AccessNode{Role: platform.RoleButton, Actions: platform.ActionPress}
+	selected := plain
+	selected.States = platform.AccessSelectionKnown | platform.AccessSelected
+	off := plain
+	off.States = platform.AccessSelectionKnown
+	for _, pair := range [][2]platform.AccessNode{{selected, off}, {selected, plain}, {off, selected}, {plain, selected}} {
+		if !(selectionItem(pair[0]) || selectionItem(pair[1])) || pair[0].Selected() == pair[1].Selected() {
+			t.Fatalf("missing transition: %+v", pair)
+		}
+	}
+	for _, n := range []platform.AccessNode{selected, off, plain} {
+		e := uiaElement{n: n}
+		if !e.supports(ifaceInvoke) || e.supports(ifaceToggle) || e.supports(ifaceSelectionItem) != (n.States&platform.AccessSelectionKnown != 0) {
+			t.Fatalf("button semantics: %+v", n)
+		}
+	}
+	checked := platform.AccessNode{Role: platform.RoleCheckBox, States: platform.AccessChecked}
+	e := uiaElement{n: checked}
+	if !e.supports(ifaceToggle) || e.supports(ifaceSelectionItem) {
+		t.Fatal("checkbox patterns changed")
+	}
+	e.n.States |= platform.AccessSelectionKnown
+	if !e.supports(ifaceToggle) || !e.supports(ifaceSelectionItem) {
+		t.Fatal("independent patterns lost")
+	}
+}
